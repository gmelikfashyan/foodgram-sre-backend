# ---- Релиз ----
# Пространство имён в Docker Hub и тег образов (sha-xxxxxxx или номер версии, например 1.0.0).
# Тег latest не используется: нужен конкретный неизменяемый идентификатор релиза.
DOCKER_USERNAME=your_dockerhub_username
IMAGE_TAG=sha-0000000

# ---- Конфигурация приложения (фактор III) ----
POSTGRES_DB=foodgram_db
DB_NAME=foodgram_db
DATABASE_USER=foodgram_user
DATABASE_PASSWORD=change_me
DB_HOST=db
DB_PORT=5432

# Объектное хранилище S3 (в compose — сервис storage). Для внешнего S3 укажите его endpoint и ключи.
S3_ENDPOINT=http://storage:9000
S3_REGION=us-east-1
S3_BUCKET=foodgram-media
S3_ACCESS_KEY=change_me_access
S3_SECRET_KEY=change_me_secret_min_8_chars
S3_PATH_STYLE=true
S3_CREATE_BUCKET=true

# Необязательно: уровень логирования (DEBUG, INFO, WARN, ERROR)
# LOG_LEVEL=INFO

# Необязательно: соль для коротких ссылок (по умолчанию как в Django-версии)
# HASHIDS_SALT=Testing_salt
